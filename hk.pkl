// Runs the checks that ./macos/build.sh performs before it compiles, so the
// same rules apply before a commit and in CI. Build and test stay in CI because
// they are too slow for every commit.
amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

steps {
  // The pinned SwiftFormat version from mise.toml. --lint reports violations
  // without writing, so the same command serves check and fix.
  ["swiftformat"] = new Step {
    glob = List("Sources/**/*.swift", "Tests/**/*.swift", "Tools/**/*.swift", "Package.swift")
    check = "mise exec -- swiftformat --lint {{files}}"
    fix = "mise exec -- swiftformat {{files}}"
  }

  // Strict lint rules from .swiftlint.yml. TOOLCHAIN_DIR matches build.sh.
  ["swiftlint"] = new Step {
    glob = List("Sources/**/*.swift", "Tests/**/*.swift", "Tools/**/*.swift", "Package.swift")
    check = "TOOLCHAIN_DIR=\"$(xcode-select -p)\" mise exec -- swiftlint lint --strict {{files}}"
  }

  // Verifies the typed localization accessors match both .lproj files. The
  // generator reads the whole repository, so the glob selects when the step
  // runs rather than passing files to it.
  ["localizations"] = new Step {
    glob = List(
      "macos/*/Localizable.strings",
      "Sources/WaddlyApp/LocalizationKey.generated.swift",
      "Tools/generate_localizations.swift"
    )
    check = "swift Tools/generate_localizations.swift --check"
  }
}
